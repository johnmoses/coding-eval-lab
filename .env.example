# Copy this file to .env and fill in your real key:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This .example file (dummy value)
# is the only env file in version control — it documents the contract.
#
# Only needed for the real OpenAI provider (--provider openai). The default stub
# provider runs fully offline and needs nothing here.

OPENAI_API_KEY=sk-your-key-here
